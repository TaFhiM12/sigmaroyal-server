model HytorcCategory {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  breadcrumb   String
  headline     String
  description  String
  highlight    String?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  products     HytorcProduct[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model HytorcProduct {
  id           String          @id @default(cuid())
  categoryId   String
  category     HytorcCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  imageUrl     String
  targetUrl    String?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categoryId])
}
