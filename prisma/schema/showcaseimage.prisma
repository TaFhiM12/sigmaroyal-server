model ShowcaseImage {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String
  location  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("showcase_images")
}
